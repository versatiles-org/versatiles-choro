{
	"name": "versatiles-choro",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"analyze": "npm run build && open stats.html",
		"build-cli": "rollup -c ./rollup.config.cli.ts",
		"build-lib": "rollup -c ./rollup.config.lib.ts",
		"build-svelte": "svelte-kit sync && vite build -l warn",
		"build": "npm run build-svelte && npm run build-lib && npm run build-cli",
		"check-svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check-svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run format:check && npm run lint && npm run check-svelte && npm run typecheck && npm run test && npm run build && npm run test:e2e",
		"cli": "tsx ./src/cli.ts",
		"dev": "mkdir -p data && DATA_PATH=data vite dev",
		"format:check": "prettier --check --cache --cache-location .prettiercache .",
		"format": "prettier --write .",
		"lint": "eslint --cache --concurrency auto .",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test:coverage": "vitest run --coverage",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"typecheck": "tsc --noEmit",
		"upgrade": "npm-check-updates -u --peer && rm -rf node_modules && rm -f package-lock.json && npm install && npm audit fix"
	},
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@sveltejs/kit": "^3.4.1",
		"@versatiles/versatiles-rs": "^5.16.0",
		"commander": "^15.1.0",
		"fast-deep-equal": "^3.1.3",
		"pino": "^10.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.80.0",
		"@playwright/test": "^1.65.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26",
		"@versatiles/style": "^9.1.3",
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"lint-staged": "^17.6.2",
		"maplibre-gl": "^6.19.0",
		"msw": "^3.0.7",
		"npm-check-updates": "^23.1.1",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"rollup": "^4.68.8",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-visualizer": "^7.3.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"msw": true
	}
}
